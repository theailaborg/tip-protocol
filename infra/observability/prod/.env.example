# cp .env.example .env on the monitoring host. Never commit .env.
OBS_DOMAIN=grafana.example.org
GRAFANA_ADMIN_PASSWORD=change-me-strong
LOGS_DOMAIN=logs.example.org
# docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
# IMPORTANT: escape every $ in the hash as $$ (compose variable interpolation).
LOKI_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_HASH

# Node API base for the Infinity datasource (dashboards read /v1/stats/scoring).
# Use a node's PRIVATE VPC IP (same host:port as your Prometheus scrape targets),
# NOT the public domain: keeps dashboard traffic inside the VPC, independent of
# Cloudflare/DNS, and off the public edge. Any node works (identical state).
#   e.g. TIP_API_BASE_URL=http://172.31.44.177:4000
TIP_API_BASE_URL=http://REPLACE_WITH_NODE_PRIVATE_IP:4000
